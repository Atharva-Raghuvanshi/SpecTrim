{
  "title": "Query Optimizer",
  "uid": "qo-main",
  "schemaVersion": 39,
  "refresh": "5s",
  "panels": [
    {
      "type": "stat",
      "title": "Sessions created (total)",
      "targets": [{"expr": "sum(qo_sessions_created_total)", "refId": "A"}],
      "gridPos": {"x": 0, "y": 0, "w": 6, "h": 4}
    },
    {
      "type": "timeseries",
      "title": "Tokens by stage (5m)",
      "targets": [
        {"expr": "sum(rate(qo_tokens_in_total[5m])) by (stage)", "refId": "A", "legendFormat": "in {{stage}}"},
        {"expr": "sum(rate(qo_tokens_out_total[5m])) by (stage)", "refId": "B", "legendFormat": "out {{stage}}"}
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "0"
        }
      },
      "gridPos": {"x": 6, "y": 0, "w": 12, "h": 8}
    },
    {
      "type": "timeseries",
      "title": "Cost (USD, 5m)",
      "targets": [
        {"expr": "sum(rate(qo_cost_usd_total[5m])) by (stage)", "refId": "A", "legendFormat": "{{stage}}"},
        {"expr": "sum(rate(qo_cost_unpriced_total[5m])) by (stage)", "refId": "B", "legendFormat": "unpriced ({{stage}})"}
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "unpriced"
        }
      },
      "gridPos": {"x": 18, "y": 0, "w": 6, "h": 4}
    },
    {
      "type": "timeseries",
      "title": "Stage latency p95 (5m)",
      "targets": [{"expr": "histogram_quantile(0.95, sum(rate(qo_stage_latency_seconds_bucket[5m])) by (le, stage))", "refId": "A", "legendFormat": "{{stage}}"}],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "noValue": "0s"
        }
      },
      "gridPos": {"x": 18, "y": 4, "w": 6, "h": 4}
    },
    {
      "type": "timeseries",
      "title": "HTTP requests (5m)",
      "targets": [{"expr": "sum(rate(qo_http_requests_total[5m])) by (path)", "refId": "A", "legendFormat": "{{path}}"}],
      "gridPos": {"x": 0, "y": 8, "w": 12, "h": 6}
    },
    {
      "type": "stat",
      "title": "Daily spend (today)",
      "targets": [{"expr": "qo_daily_spend_usd", "refId": "A"}],
      "gridPos": {"x": 12, "y": 8, "w": 6, "h": 6}
    },
    {
      "type": "timeseries",
      "title": "Per-pass token savings (est, 5m)",
      "targets": [{"expr": "sum(rate(qo_pass_savings_tokens_est_total[5m])) by (pass)", "refId": "A", "legendFormat": "{{pass}}"}],
      "fieldConfig": {
        "defaults": {
          "noValue": "0"
        }
      },
      "gridPos": {"x": 0, "y": 14, "w": 8, "h": 6}
    },
    {
      "type": "stat",
      "title": "Cache hit rate (15m)",
      "targets": [{"expr": "(sum(rate(qo_proxy_cache_hits_total[15m])) / clamp_min(sum(rate(qo_proxy_requests_total[15m])), 0.001)) * 100", "refId": "A"}],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 1,
          "min": 0,
          "max": 100
        }
      },
      "gridPos": {"x": 8, "y": 14, "w": 4, "h": 6}
    },
    {
      "type": "timeseries",
      "title": "Passthrough / fail-open (5m)",
      "targets": [{"expr": "sum(rate(qo_proxy_passthrough_total[5m])) by (reason)", "refId": "A", "legendFormat": "{{reason}}"}],
      "gridPos": {"x": 12, "y": 14, "w": 6, "h": 6}
    },
    {
      "type": "stat",
      "title": "Validity-guard events (total)",
      "targets": [
        {"expr": "sum(qo_proxy_invalid_after_pass_total)", "refId": "A"},
        {"expr": "sum(qo_proxy_invalid_original_total)", "refId": "B"}
      ],
      "gridPos": {"x": 0, "y": 20, "w": 6, "h": 4}
    },
    {
      "type": "timeseries",
      "title": "Added proxy overhead p95 (target <150ms, 5m)",
      "targets": [{"expr": "histogram_quantile(0.95, sum(rate(qo_proxy_overhead_seconds_bucket[5m])) by (le))", "refId": "A", "legendFormat": "p95"}],
      "gridPos": {"x": 18, "y": 14, "w": 6, "h": 6}
    }
  ]
}
