{
  "session_id": "ses_1a359a8004cf",
  "version": 1,
  "master_spec": {
    "summary": "The Recipe Box lets users capture, store, and retrieve personal recipes. Users can add recipes with ingredients, steps, and optional photos, then tag them for easy organization. Tags are flat (non‑hierarchical) and can be created on the fly. The system provides search, filtering, and basic management capabilities while applying sensible defaults for pagination, sorting, and visibility.",
    "user_flows": [
      "A user signs up, creates a new recipe, adds flat tags, and saves it to their personal box.",
      "A user browses their saved recipes, applies tag filters, and opens a recipe to view details.",
      "A user edits an existing recipe, updates tags, and confirms the changes are persisted."
    ],
    "features": [
      {
        "id": "F1",
        "title": "Create and Save Recipe",
        "acceptance": [
          "Given a logged‑in user, when they submit a recipe form with required fields (title, ingredients, steps), then the recipe is stored and appears in their recipe list.",
          "If optional fields (photo, notes) are omitted, the recipe is still saved using sensible defaults for missing data."
        ]
      },
      {
        "id": "F2",
        "title": "Flat Tagging System",
        "acceptance": [
          "When a user adds a tag to a recipe, the tag is stored as a flat label without parent/child relationships.",
          "Duplicate tags entered for the same recipe are ignored, ensuring each tag appears only once per recipe."
        ]
      },
      {
        "id": "F3",
        "title": "Search and Filter Recipes",
        "acceptance": [
          "When a user enters a keyword or selects one or more tags, the system returns only recipes matching the criteria.",
          "Results are paginated with a sensible default page size of 20 items."
        ]
      },
      {
        "id": "F4",
        "title": "Edit and Delete Recipes",
        "acceptance": [
          "A user can modify any field of an existing recipe and save changes, which are reflected immediately in the recipe list.",
          "A user can delete a recipe, after confirming the action, and the recipe no longer appears in any view."
        ]
      },
      {
        "id": "F5",
        "title": "View Recipe Details",
        "acceptance": [
          "Selecting a recipe from the list opens a detail view showing title, ingredients, steps, tags, and any attached photo.",
          "The detail view loads within 2 seconds under normal load conditions."
        ]
      },
      {
        "id": "F6",
        "title": "Export and Share Recipe",
        "acceptance": [
          "A user can export a recipe as a printable PDF or share a generated link that displays the recipe in read‑only mode.",
          "Exported PDFs include all recipe fields and use a default layout when no custom template is specified."
        ]
      }
    ],
    "non_functional": [
      "Performance: All UI actions (create, edit, search, view) must respond within 2 seconds for 95% of requests.",
      "Scalability: System must support at least 10,000 concurrent users with graceful degradation.",
      "Security: Data must be stored encrypted at rest and transmitted over TLS 1.2+.",
      "Usability: Interface follows accessibility standards (WCAG 2.1 AA) and provides sensible defaults for form fields.",
      "Reliability: Automatic daily backups with a retention period of 30 days.",
      "Data Privacy: Users can permanently delete their account and all associated recipes."
    ]
  },
  "assumptions": [
    {
      "id": "A1",
      "text": "Should tags support hierarchical relationships or remain flat?",
      "rationale": "blocking but question cap reached; confidence 0.95: Tag hierarchy decisions affect core data structures and persistence, making it blocking.",
      "category": "suppressed_blocking",
      "overridable": false
    }
  ],
  "open_questions": [
    {
      "id": "Q1",
      "text": "Should users be required to register/login or can they save recipes anonymously?",
      "category": "auth_model",
      "answer": null
    },
    {
      "id": "Q2",
      "text": "Are saved recipes private, shareable, or publicly visible?",
      "category": "data_ownership",
      "answer": null
    },
    {
      "id": "Q3",
      "text": "Is the product delivered as a web app, mobile app, or both?",
