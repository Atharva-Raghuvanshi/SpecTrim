  "version": 1,
  "master_spec": {
    "summary": "RoomieSplit lets roommates quickly log shared expenses, automatically calculates each person's share, and tracks who owes whom. Users can choose equal, percentage‑based, or itemized splits, receive optional reminders for unpaid balances, and keep all data securely on their device with easy backup options.",
    "user_flows": [
      "A roommate adds a new expense, selects who paid and who participated, chooses a split method, and the app instantly updates each person's balance.",
      "A roommate opens the balances view to see who owes them money and who they owe, then records a payment to settle part of the debt.",
      "The system sends a reminder notification to roommates with outstanding balances according to the configured schedule."
    ],
    "features": [
      {
        "id": "F1",
        "title": "Create Expense Entry",
        "acceptance": [
          "User can input amount, description, date, payer, and participants.",
          "System stores the expense record locally upon submission.",
          "Expense appears immediately in the balances view."
        ]
      },
      {
        "id": "F2",
        "title": "Select Split Method",
        "acceptance": [
          "User can choose between equal split, custom percentages, or itemized shares.",
          "For custom percentages, the sum of all percentages must equal 100% before saving.",
          "For itemized shares, each participant can be assigned a specific amount or percentage per line item."
        ]
      },
      {
        "id": "F3",
        "title": "View Current Balances",
        "acceptance": [
          "Balances view lists each roommate with a net amount owed or owed to the user.",
          "Balances update in real time as new expenses or settlements are recorded.",
          "User can filter the view by date range or by specific roommate."
        ]
      },
      {
        "id": "F4",
        "title": "Record Payment Settlement",
        "acceptance": [
          "User can mark a payment as made, specifying amount, payer, and payee.",
          "System adjusts the balances of both parties accordingly.",
          "Settlement entries are stored locally and appear in the expense history."
        ]
      },
      {
        "id": "F5",
        "title": "Automatic Reminder Notifications",
        "acceptance": [
          "System sends a push notification for any unpaid balance according to the default weekly schedule.",
          "User can enable/disable reminders and change the frequency (daily, weekly, monthly).",
          "Reminder content includes the amount owed and the roommate who owes it."
        ]
      },
      {
        "id": "F6",
        "title": "Local Data Persistence with Export/Import",
        "acceptance": [
          "All expense, split, and settlement data are stored locally on the device.",
          "Data is encrypted at rest using platform‑provided encryption APIs.",
          "User can export data to a JSON file and import from such a file for backup or migration."
        ]
      }
    ],
    "non_functional": [
      "Offline‑first: core functionality works without network connectivity.",
      "Data privacy: no data is transmitted to external servers unless the user explicitly performs an export.",
      "Responsive UI: interactions complete within 200 ms on typical mobile hardware.",
      "Scalability: support up to 20 roommates and 10,000 expense records without performance degradation.",
      "Accessibility: UI complies with WCAG 2.1 AA guidelines."
    ]
  },
  "assumptions": [
    {
      "id": "A1",
      "text": "Will data be stored locally on device, on a central server, or optionally self-hosted?",
