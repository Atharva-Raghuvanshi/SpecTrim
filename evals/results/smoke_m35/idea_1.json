  "master_spec": {
    "summary": "The personal habit tracker lets users define habits with flexible schedules (daily, weekly, or specific days) and automatically records completions to calculate streaks that respect each habit's schedule. Users can quickly check in, view real‑time streak counts, and see a dashboard of all habits with progress indicators. Sensible defaults provide timely reminders and seamless offline persistence, while the UI remains simple and intuitive.",
    "user_flows": [
      "User creates a new habit, selects a schedule (e.g., every Monday and Thursday), and saves it; the habit appears on the dashboard with the next due date.",
      "User opens the app, marks a habit as completed for the current period, and sees the streak count increment accordingly.",
      "User reviews the dashboard, notices a streak warning for a missed habit, and decides to adjust the reminder settings."
    ],
    "features": [
      {
        "id": "F1",
        "title": "Flexible Habit Creation",
        "acceptance": [
          "User can create a habit with a name and select a schedule type: daily, weekly, or specific days of the week.",
          "The selected schedule is stored and displayed correctly on the habit detail view."
        ]
      },
      {
        "id": "F2",
        "title": "Period‑Based Check‑In",
        "acceptance": [
          "User can mark a habit as completed for the current period (day or week) with a single tap.",
          "The UI updates to show the habit as completed for that period."
        ]
      },
      {
        "id": "F3",
        "title": "Schedule‑Aware Streak Tracking",
        "acceptance": [
          "Streak count increments only when the habit is completed for every required period according to its schedule.",
          "If a required period is missed, the streak resets to zero.",
          "Streak display updates in real time after each check‑in."
        ]
      },
      {
        "id": "F4",
        "title": "Dashboard with Progress Overview",
        "acceptance": [
          "Dashboard lists all active habits with name, schedule icon, next due date, and current streak.",
          "Habits that are overdue are visually highlighted.",
          "Tapping a habit opens its detail view."
        ]
      },
      {
        "id": "F5",
        "title": "Default Reminder Notifications",
        "acceptance": [
          "App sends a push notification at a sensible default time (e.g., 9:00 AM) reminding the user of due habits.",
          "User can mute or adjust reminder settings from the settings screen."
        ]
      },
      {
        "id": "F6",
        "title": "Offline Persistence and Sync",
        "acceptance": [
          "All habit definitions and completion records are stored locally and survive app restarts.",
          "When network connectivity is restored, data syncs to the cloud without data loss."
        ]
      }
    ],
    "non_functional": [
      "Responsive UI: all interactions complete within 200 ms on typical mobile hardware.",
      "Data privacy: habit data is encrypted at rest and in transit.",
      "Accessibility: UI meets WCAG 2.1 AA standards for color contrast and screen‑reader support.",
      "Scalability: system supports at least 10,000 concurrent users without degradation.",
      "Reliability: 99.9% uptime for cloud sync services.",
      "Battery efficiency: background reminder service consumes less than 1% battery per day."
    ]
  },
  "assumptions": [
