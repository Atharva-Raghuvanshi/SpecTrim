DATABASE_URL=postgresql://app:app@postgres:5432/qo
API_BEARER_TOKEN=change-me
GROQ_API_KEY=
OPENROUTER_API_KEY=
PROVIDER_A_API_KEY=
PROVIDER_B_API_KEY=
MODELS_CONFIG=config/models.yaml
ACTIVE_CONFIG=single_model
SPEND_CAP_USD_PER_DAY=10
MAX_COST_USD_PER_SESSION=0.50
MAX_QUESTIONS_PER_ROUND=3
LEASE_SECONDS=60
LEASE_RENEW_SECONDS=20
LOG_LEVEL=INFO

# Host port overrides. Defaults avoid clashing with other local stacks
# (host 8000/5432 are commonly taken). In-container ports stay 8000/5432.
QO_API_PORT=8001
QO_PG_PORT=5433
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=qo
